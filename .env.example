# Discord Developer Portal → Bot → Reset Token
DISCORD_TOKEN=

# Comma-separated channel snowflakes the bot will listen in.
# Enable Developer Mode in Discord, right-click channel → Copy Channel ID.
ALLOWED_CHANNEL_IDS=

# Optional: only these user snowflakes may talk to the bot (in allowed channels or DMs).
# ALLOWED_USER_IDS=

ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# The bot does not call Google Drive. It only reads .wpilog files from this local folder.
# Point this at the Drive-for-Desktop path, or at a folder rclone/cron keeps in sync.
LOG_DIR=./data/logs

# ClaudeScope binary name or absolute path. Install from
# https://github.com/rylero/ClaudeScope/releases and put it on PATH.
# CLAUDESCOPE_BIN=ClaudeScope

# Separate checkout of https://github.com/rylero/chiefdelphi-mcp
# Defaults to ../chiefdelphi-mcp (sibling of this repo).
# CHIEFDELPHI_MCP_CWD=C:/Users/ryan/Dev/chiefdelphi-mcp

# Optional. Only if you use rclone instead of Drive for Desktop.
# Example: gdrive:FRC/Logs
# RCLONE_REMOTE=
