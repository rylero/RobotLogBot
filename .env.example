# Discord Developer Portal → Bot → Reset Token
DISCORD_TOKEN=

# Comma-separated channel snowflakes the bot will listen in.
# Enable Developer Mode in Discord, right-click channel → Copy Channel ID.
ALLOWED_CHANNEL_IDS=

# Optional: only these user snowflakes may talk to the bot (in allowed channels or DMs).
# ALLOWED_USER_IDS=

ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# Local folder of .wpilog files. On the closet server this is the rclone sync target
# for the team's Google Drive log folder.
LOG_DIR=./data/logs

# ClaudeScope binary name or absolute path. Must be on PATH on the closet server.
# CLAUDESCOPE_BIN=ClaudeScope

# Chief Delphi MCP checkout (stdio). Defaults to the vendor/chiefdelphi-mcp submodule.
# CHIEFDELPHI_MCP_CWD=./vendor/chiefdelphi-mcp

# Optional: rclone remote:path that mirrors the Drive folder into LOG_DIR.
# Example: gdrive:FRC/Logs
# RCLONE_REMOTE=
